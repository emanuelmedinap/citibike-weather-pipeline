# Only needed to RE-RUN the pipeline (ingest + BigQuery). The dashboard and the
# tests need none of this: they read the committed parquet bundle.
# Copy to .env, fill in your own values. .env is gitignored.

GCP_PROJECT=YOUR_GCP_PROJECT            # your own GCP project id
GCS_BUCKET=YOUR_GCP_PROJECT-citibike-raw # staging bucket for the raw zips
BQ_LOCATION=US                           # must match bigquery-public-data.ghcn_d
